# ---- Belanja environment configuration -------------------------------
# Copy this file to .env and adjust values. NEVER commit .env.
# This template is tuned for the native Termux setup (no Docker):
# the app is served on http://127.0.0.1 and PostgreSQL runs on 127.0.0.1:5432.
# ./scripts/setup-termux.sh creates .env from this file automatically and
# replaces JWT_SECRET / POSTGRES_PASSWORD with randomly generated values.

# --- Application ------------------------------------------------------
# Runtime mode. Production enables Secure cookies + HTTPS subresource upgrade.
NODE_ENV=development
# Host/port the backend binds to. http://127.0.0.1:3000 is the Termux URL.
# Set HOST=0.0.0.0 only if you also want LAN/`adb reverse` access on the phone.
HOST=127.0.0.1
PORT=3000
# IANA timezone defining the app's "current calendar month".
# Monthly lifecycle rules (open/close/reopen/auto-close) are computed from here.
APP_TIMEZONE=Asia/Kuala_Lumpur
# Origin(s) allowed for CORS (comma separated). Same-origin is always allowed.
CORS_ORIGIN=http://127.0.0.1:3000
# How long JWT stays valid (e.g. 7d, 1d, 12h)
JWT_EXPIRES_IN=7d

# --- Request logging --------------------------------------------------
# Log every non-static request with duration (useful to profile the node
# backend). When unset/false (default Termux mode) the log stays quiet:
# static files are not logged and only failed /api responses and errors are.
# LOG_REQUESTS=false

# --- Security ----------------------------------------------------------
# IMPORTANT: generate a strong random secret:  openssl rand -hex 48
# The Termux setup script generates one automatically when creating .env.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Rate limiting (requests per 15 minutes per client IP) --------------
# Overall limit for /api/auth (COVERS /me, which runs on every page load)
RATE_LIMIT_AUTH=300
# Strict limit for login + register only (brute-force guard)
RATE_LIMIT_AUTH_LOGIN=30
# Limit for all other /api endpoints
RATE_LIMIT_API=600

# --- PostgreSQL (native Termux install) --------------------------------
# Credentials used to create the local database/user AND the app connection.
POSTGRES_USER=belanja
POSTGRES_PASSWORD=belanja-strong-password
POSTGRES_DB=belanja
# Postgres data schema used by the app
POSTGRES_SCHEMA=belanja
# Connection string used by the backend (native Termux PostgreSQL on 127.0.0.1).
DATABASE_URL=postgres://belanja:belanja-strong-password@127.0.0.1:5432/belanja
# Apply migrations automatically when the backend starts (idempotent).
RUN_MIGRATIONS=true